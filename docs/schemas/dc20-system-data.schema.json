{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dunorgames.local/schemas/dc20-system-data/1.0",
  "title": "DC20 systemData",
  "type": "object",
  "required": ["level", "role", "statistics", "attributes", "sections"],
  "properties": {
    "level": { "type": "integer", "minimum": 0 },
    "role": { "type": "string", "minLength": 1 },
    "creatureDetails": { "type": "string" },
    "statistics": {
      "type": "object",
      "required": ["hitPoints", "physicalDefense", "arcaneDefense"],
      "properties": {
        "hitPoints": { "type": "integer", "minimum": 0 },
        "physicalDefense": { "$ref": "#/$defs/threeThresholds" },
        "arcaneDefense": { "$ref": "#/$defs/threeThresholds" }
      },
      "additionalProperties": true
    },
    "attributes": {
      "type": "object",
      "required": ["mig", "agi", "cha", "int"],
      "properties": {
        "mig": { "$ref": "#/$defs/attribute" },
        "agi": { "$ref": "#/$defs/attribute" },
        "cha": { "$ref": "#/$defs/attribute" },
        "int": { "$ref": "#/$defs/attribute" }
      },
      "additionalProperties": true
    },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/namedBonus" } },
    "senses": { "type": "array", "items": { "type": "string" } },
    "languages": { "type": "array", "items": { "type": "string" } },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "entries"],
        "properties": {
          "kind": { "enum": ["features", "actions", "reactions", "other"] },
          "title": { "type": "string" },
          "count": { "type": "integer", "minimum": 0 },
          "entries": { "type": "array", "items": { "$ref": "#/$defs/ruleEntry" } }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "threeThresholds": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "integer" }
    },
    "attribute": {
      "type": "object",
      "required": ["value"],
      "properties": { "value": { "type": "integer" }, "alternateValue": { "type": "integer" } },
      "additionalProperties": true
    },
    "namedBonus": {
      "type": "object",
      "required": ["name", "bonus"],
      "properties": { "name": { "type": "string" }, "bonus": { "type": "integer" } },
      "additionalProperties": true
    },
    "ruleEntry": {
      "type": "object",
      "required": ["name", "text"],
      "properties": {
        "name": { "type": "string" },
        "cost": { "type": "string" },
        "attack": { "type": "object", "additionalProperties": true },
        "enhancements": { "type": "array", "items": { "$ref": "#/$defs/ruleEntry" } },
        "outcomes": { "type": "array", "items": { "$ref": "#/$defs/ruleEntry" } },
        "text": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
