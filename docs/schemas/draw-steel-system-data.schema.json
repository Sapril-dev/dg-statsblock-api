{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dunorgames.local/schemas/draw-steel-system-data/1.0",
  "title": "Draw Steel systemData",
  "type": "object",
  "required": ["level", "organization", "role", "encounterValue", "statistics", "characteristics", "signatureAbility"],
  "properties": {
    "level": { "type": "integer", "minimum": 1 },
    "organization": { "enum": ["minion", "horde", "platoon", "elite", "leader", "solo"] },
    "role": { "type": "string", "minLength": 1 },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "encounterValue": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "forMinions": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "statistics": {
      "type": "object",
      "required": ["size", "speed", "stamina", "stability", "freeStrike"],
      "properties": {
        "size": { "type": "string" },
        "speed": { "type": "integer", "minimum": 0 },
        "stamina": { "type": "integer", "minimum": 0 },
        "stability": { "type": "integer" },
        "freeStrike": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "immunities": { "type": "array", "items": { "type": "string" } },
    "weakness": { "type": ["string", "null"] },
    "movement": { "type": ["string", "null"] },
    "withCaptain": { "type": ["string", "null"] },
    "characteristics": {
      "type": "object",
      "required": ["might", "agility", "reason", "intuition", "presence"],
      "properties": {
        "might": { "type": "integer" },
        "agility": { "type": "integer" },
        "reason": { "type": "integer" },
        "intuition": { "type": "integer" },
        "presence": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "signatureAbility": { "$ref": "#/$defs/ability" },
    "abilities": { "type": "array", "items": { "$ref": "#/$defs/ability" } },
    "traits": { "$ref": "#/$defs/ruleEntries" },
    "maliceAbilities": { "type": "array", "items": { "$ref": "#/$defs/ability" } },
    "villainActions": { "type": "array", "items": { "$ref": "#/$defs/ability" } }
  },
  "$defs": {
    "ability": {
      "type": "object",
      "required": ["name", "category", "text"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "category": { "enum": ["signature", "main", "maneuver", "triggered", "freeTriggered", "malice", "villain", "other"] },
        "cost": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "distance": { "type": "string" },
        "target": { "type": "string" },
        "powerRoll": {
          "type": "object",
          "properties": {
            "formula": { "type": "string" },
            "tiers": { "type": "array", "items": { "$ref": "#/$defs/outcome" } }
          },
          "additionalProperties": true
        },
        "text": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "outcome": {
      "type": "object",
      "required": ["range", "text"],
      "properties": { "range": { "type": "string" }, "text": { "type": "string" } },
      "additionalProperties": true
    },
    "ruleEntries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "text"],
        "properties": { "name": { "type": "string" }, "text": { "type": "string" } },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
